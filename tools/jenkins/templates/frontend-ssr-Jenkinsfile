// ===================================================================
// Jenkinsfile — Next.js 前后端不分离 SSR 应用 (standalone + Docker + SSH 部署)
// 流水线: Checkout → Install → {{TEST_STAGE_NAME}} → Build (next build standalone)
//        → Docker Build & Push → Deploy to Server (docker run)
// 生成: python3 scripts/generate-jenkinsfile.py -y ./jenkins-config.yml
// 前置: ① next.config.js 已配置 output: "standalone"
//       ② 项目根 Dockerfile 由生成器同步输出 (node:22-alpine + standalone)
//       ③ 服务器信息由 Jenkins Job 参数默认值维护 (仓库不保存)
// 环境变量: APP_ENV_VARS 文本参数逐行注入 (KEY=VALUE), 由 Job 配置维护
//          (如 AUTH_SECRET/DATABASE_URL/FEEDBACK_API_URL 等, 敏感值走 Jenkins 凭据/Job)
// ===================================================================
pipeline {
    agent any

    // --- 参数化构建配置 ---
    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['prod', 'dev', 'test'], description: '选择打包的环境模式')

        // --- 版本控制 ---
        string(name: 'NODE_VERSION', defaultValue: '22', description: '使用的 Node.js 版本 (将由 nvm 安装/切换)')

        // --- 凭证 ID 配置 ---
        string(name: 'GIT_CREDENTIAL_ID', defaultValue: 'my-spa-git', description: 'Git 仓库访问凭证 ID')

        // --- Docker 镜像参数 ---
        string(name: 'DOCKER_IMAGE_NAME', defaultValue: 'my-ssr-app', description: 'Docker 镜像名')
        string(name: 'DOCKER_REGISTRY', defaultValue: '192.168.1.7:5000', description: 'Docker 私有仓库上传地址 (push)')
        string(name: 'DOCKER_REGISTRY_CACHE', defaultValue: '192.168.1.7:5001', description: 'Docker 拉取地址/公共镜像缓存 (pull + 基础镜像)')
        string(name: 'DOCKER_CREDENTIALS_ID', defaultValue: 'docker-hub', description: '镜像仓库登录凭证 ID')
        string(name: 'IMAGE_DIGEST_OVERRIDE', defaultValue: '', description: '回滚用：指定 image@sha256 摘要（留空=用本次构建产物）；#540 digest 钉住')

        // --- SSH 部署参数 (服务器信息由 Jenkins Job 参数默认值维护) ---
        booleanParam(name: 'RUN_DEPLOY', defaultValue: false, description: '显式请求部署（默认 false：构建完不部署）—— 构建后部署到服务器：SSH docker run 启动容器')
        string(name: 'DEPLOY_HOST', defaultValue: 'server.example.com', description: '服务器主机地址（IP 或域名）——请在 Jenkins Job 参数默认值中填写')
        string(name: 'DEPLOY_PORT', defaultValue: '22', description: '服务器 SSH 端口')
        string(name: 'SSH_USER', defaultValue: 'root', description: 'SSH 登录用户（云厂商密钥对通常绑定 root）')
        string(name: 'DEPLOY_CREDENTIAL_ID', defaultValue: 'deploy-key', description: 'SSH 私钥凭证 ID（Jenkins 凭据管理）')
        string(name: 'APP_PORT', defaultValue: '3000', description: '容器内应用端口 (Next.js standalone 默认 3000)')
        string(name: 'EXPOSE_APP_PORT', defaultValue: '3000', description: '宿主机映射端口')
        string(name: 'HEALTH_PATH', defaultValue: '/health', description: '部署后健康检查路径 (HTTP GET；静态站点可用 / )')
        text(name: 'APP_ENV_VARS', defaultValue: 'NODE_ENV=production', description: '容器环境变量，每行 KEY=VALUE（AUTH_SECRET/DATABASE_URL/FEEDBACK_API_URL 等，由 Job 配置维护）')
    }

    environment {
        NODE_OPTIONS = "--max-old-space-size=4096"
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        timeout(time: 40, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout & Init') {
            steps {
                checkout scm
                script {
                    if (env.BRANCH_NAME == null || env.BRANCH_NAME == '') {
                        // 分支识别（#455 同尖消歧）：GIT_BRANCH 优先 → for-each-ref 按「可部署分支优先」确定化 → name-rev 兜底
                        // 旧逻辑仅用 name-rev，多 ref 同指一 commit（develop 与 release/* 同尖）时不确定，会误判 develop
                        env.BRANCH_NAME = sh(returnStdout: true, script: '''
                            b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
                            if [ -z "$b" ] || [ "$b" = "HEAD" ]; then
                                b="${GIT_BRANCH#origin/}"
                            fi
                            if [ -z "$b" ] || [ "$b" = "HEAD" ]; then
                                # name-rev 在多 ref 同指一 commit 时选择不确定(如 develop 与 release/* 同尖) → 按「可部署分支优先」确定化
                                b=$(git for-each-ref --points-at HEAD --format='%(refname:short)' refs/remotes/origin 2>/dev/null | sed 's#^origin/##' | grep -v '^HEAD$' | awk 'BEGIN{p=99}{q=99; if(index($0,"release/")==1||index($0,"hotfix/")==1)q=1; else if($0=="main"||$0=="master")q=2; else if($0=="develop"||$0=="dev")q=3; if(q<p){p=q;r=$0}}END{print r}')
                            fi
                            if [ -z "$b" ]; then
                                b=$(git name-rev --name-only --refs="refs/remotes/origin/*" HEAD 2>/dev/null | sed 's#^remotes/origin/##; s#^origin/##' | cut -d'^' -f1)
                            fi
                            echo "$b"
                        ''').trim()
                    }
                    echo "Current Branch: ${env.BRANCH_NAME}"
                    echo "Node: ${params.NODE_VERSION} | DEPLOY_ENV: ${params.DEPLOY_ENV} | Deploy: ${params.RUN_DEPLOY}"
                }
            }
        }

        // ⚠ 规则：Install 必须是独立阶段，且位于所有需要依赖的阶段（编译/测试）之前
        stage('Install Dependencies') {
            steps {
                script {
                    sh """
                        export NVM_DIR="\$HOME/.nvm"
                        [ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"

                        if ! command -v nvm &> /dev/null; then
                            echo "❌ 错误: 未在系统中找到 nvm，请确保 Jenkins Agent 已安装 nvm。"
                            exit 1
                        fi

                        echo "--- 1. 使用 nvm 准备 Node 环境 (${params.NODE_VERSION}) ---"
                        nvm install ${params.NODE_VERSION}
                        nvm use ${params.NODE_VERSION}

{{PKG_SETUP}}
                        echo "--- 2. 环境检查 ---"
                        node -v
                        {{PKG_NAME}} -v

                        echo "--- 3. 安装依赖 ---"
                        {{PKG_INSTALL}}
                    """
                }
            }
        }

{{TEST_STAGE_BLOCK}}
        // ⚠ 规则：测试阶段必须在 Install 之后；禁止用 npx 兜底缺失依赖（npx 会临时下载最新版，版本漂移）
        stage('{{TEST_STAGE_NAME}}') {
            steps {
                script {
                    sh """
                        export NVM_DIR="\$HOME/.nvm"
                        [ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"
                        nvm use ${params.NODE_VERSION} >/dev/null 2>&1 || nvm install ${params.NODE_VERSION}
{{PKG_PATH}}
                        if [ -f scripts/check.sh ]; then
                            echo "--- 质量门禁: 统一入口 scripts/check.sh (Jenkins/本地同源, #397) ---"
                            bash scripts/check.sh --stage all
                        else
                            echo "--- 质量门禁: {{TEST_COMMAND}} (回退；建议补齐 scripts/check.sh, #397) ---"
                            {{TEST_COMMAND}}
                        fi
                    """
                }
            }
        }
{{/TEST_STAGE_BLOCK}}

        stage('Next.js Build') {
            steps {
                script {
                    // 构建期注入环境变量：Next 的 env 校验会在 next build 时读取 .env（#207 教训）
                    def buildEnvVars = {{APP_ENV_EXPR}}
                    if (buildEnvVars?.trim()) {
                        writeFile file: '.env', text: buildEnvVars
                        echo '--- 已写入 .env（构建期环境变量）---'
                    }
                    // 字体/网络抖动会让 next build 的字体下载失败（实测遇到过）→ 重试
                    retry(3) {
                    sh """
                        export NVM_DIR="\$HOME/.nvm"
                        [ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"
                        nvm use ${params.NODE_VERSION} >/dev/null 2>&1 || nvm install ${params.NODE_VERSION}
{{PKG_PATH}}
                        # next.config 不读 .env（Next.js 限制）—— 显式 source，供构建期 next.config 读取（如 BUILD_STANDALONE）
                        if [ -f .env ]; then set -a; . ./.env; set +a; fi
                        echo "--- 执行打包 (next build, standalone 输出 .next/standalone) ---"
                        {{PKG_RUN}} build
                        echo "--- standalone 产物 ---"
                        ls -la .next/standalone | head -10
                    """
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    // [校验] Dockerfile 语法: 优先官方 docker build --check (Docker 25+/BuildKit), 无则静态规则
                    sh """
                        set -e
                        echo "--- Dockerfile 语法校验 ---"
                        if command -v docker >/dev/null 2>&1 && docker build --help 2>&1 | grep -q -- '--check'; then
                            docker build --check .
                        else
                            if grep -nE '^[[:space:]]*(FROM|ARG|COPY|RUN|ENV|WORKDIR|EXPOSE|CMD|ENTRYPOINT|LABEL|USER|ADD) .*#' Dockerfile; then
                                echo '❌ Dockerfile 存在指令级行尾注释 (Dockerfile 不支持行内 # 注释)'
                                exit 1
                            fi
                            echo '⚠️ 无 docker build --check, 已按静态规则校验通过 (行尾注释/FROM)'
                        fi
                    """

                    def tag = "${params.DEPLOY_ENV}-${env.BUILD_NUMBER}"
                    env.IMAGE_TAG = tag
                    echo "--- 构建镜像 ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}:${tag} ---"
                    withCredentials([usernamePassword(
                        credentialsId: params.DOCKER_CREDENTIALS_ID,
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )]) {
                        // 镜像内 next build 也会拉取字体，网络抖动时重试一次
                        retry(2) {
                        sh """
                            set -e
                            docker build --build-arg NODE_BASE_IMAGE=${params.DOCKER_REGISTRY_CACHE}/library/node:${params.NODE_VERSION}-alpine \
                                         -t ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}:${tag} .
                            echo "--- 推送镜像到私有仓库 ---"
                            echo "${REGISTRY_PASS}" | docker login ${params.DOCKER_REGISTRY} -u ${REGISTRY_USER} --password-stdin
                            docker push ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}:${tag}
                            docker logout ${params.DOCKER_REGISTRY}
                        """
                        }
                    }
                    // #540 制品 digest 钉住：解析推送后的不可变摘要（部署以 image@sha256 引用，弃 tag）
                    env.IMAGE_DIGEST = sh(returnStdout: true, script: "docker image inspect ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}:${tag} | tr -d '[:space:]' | grep -oE '@sha256:[0-9a-f]{64}' | head -1 | cut -c2-").trim()
                    if (!(env.IMAGE_DIGEST ==~ /sha256:[0-9a-f]{64}/)) {
                        error "❌ 无法解析镜像 digest（得到: '${env.IMAGE_DIGEST}'）——#540 digest 钉住"
                    }
                    writeFile file: '.image-digest', text: env.IMAGE_DIGEST + "\n"
                    echo "--- 镜像 digest = ${env.IMAGE_DIGEST} ---"
                }
            }
        }

        stage('Deploy Gates (G0–G3 · #398)') {
            when { expression { return params.RUN_DEPLOY } }
            steps {
                script {
                    sh """
                        if [ -f scripts/deploy-gate.sh ]; then
                            echo "--- 部署门禁 G0-G3 (env=${params.DEPLOY_ENV}, branch=${env.BRANCH_NAME}) ---"
                            bash scripts/deploy-gate.sh --env "${params.DEPLOY_ENV}" --branch "${env.BRANCH_NAME}" --run-deploy "${params.RUN_DEPLOY}"
                        else
                            echo "❌ 缺部署门禁脚本 scripts/deploy-gate.sh（#398，install-jenkinsfile-gate.sh 安装）"; exit 1
                        fi
                    """
                }
            }
        }

        stage('Deploy to Server') {
            when { expression { return params.RUN_DEPLOY } }
            steps {
                script {
                    if (!params.DEPLOY_HOST || params.DEPLOY_HOST.contains('example.com')) {
                        error "❌ 未配置 DEPLOY_HOST：请在 Jenkins Job 配置 → 参数化构建过程 → DEPLOY_HOST 默认值中填写服务器地址（IP 或域名）后重试"
                    }
{{APP_ENV_CRED_OPEN}}
                    def appEnvVars = {{APP_ENV_EXPR}}
                    if (!appEnvVars?.trim()) {
                        error "❌ 容器环境变量为空：请配置 APP_ENV_VARS 参数或 app_env_credential_id 凭据后重试"
                    }
                    // [快速失败] 占位符密钥不允许上到容器（否则应用会以假 AUTH_SECRET / DB 凭据启动，静默坏掉）
                    if (appEnvVars.contains('SET_IN_JENKINS_JOB') || appEnvVars.contains('change_me') || appEnvVars.contains('change-me-in-production')) {
                        error "❌ APP_ENV_VARS 仍是占位符（SET_IN_JENKINS_JOB / change_me）：请填写真实密钥（AUTH_SECRET / DB_* 等）后重试"
                    }
                    // [安全] 写入文件而不是拼到命令行：writeFile 不打印内容，容器用 --env-file 加载，
                    //       避免密钥出现在构建日志 / sh -x 跟踪里（曾在 echo envArgs 处泄露 AUTH_SECRET/DB_PASS）
                    writeFile file: '.deploy-env', text: appEnvVars
                    // #540 digest 钉住（含回滚覆盖）：部署一律以 image@sha256 引用
                    def imageDigest = (params.IMAGE_DIGEST_OVERRIDE?.trim()) ?: (env.IMAGE_DIGEST ?: readFile('.image-digest').trim())
                    if (!(imageDigest ==~ /sha256:[0-9a-f]{64}/)) {
                        error "❌ digest 非法（得到: '${imageDigest}'）——#540"
                    }
                    def imageRef = "${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}@${imageDigest}"
                    echo "--- 部署镜像（digest 钉住）: ${imageRef} ---"

                    withCredentials([sshUserPrivateKey(
                        credentialsId: params.DEPLOY_CREDENTIAL_ID,
                        keyFileVariable: 'DEPLOY_KEY',
                        usernameVariable: 'DEPLOY_CRED_USER'
                    )]) {
                        sh """
                            set -e
                            SSH_OPTS="-i \${DEPLOY_KEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=20"
                            REMOTE="${params.SSH_USER}@${params.DEPLOY_HOST}"

                            if ! ssh \${SSH_OPTS} -o BatchMode=yes -p ${params.DEPLOY_PORT} \${REMOTE} 'echo OK' > /dev/null 2>&1; then
                                echo "❌ SSH 预检失败：无法以 ${params.SSH_USER}@${params.DEPLOY_HOST} 登录（凭证 ${params.DEPLOY_CREDENTIAL_ID}）"
                                echo "   排查: ① 用户存在? ② authorized_keys 权限 700/600? ③ 私钥无 passphrase? ④ 密钥对与用户匹配?"
                                exit 1
                            fi
                            echo "✅ SSH 预检通过"

                            echo "--- 部署: 传环境变量文件 + docker pull + 停旧容器 + 启动新容器 ---"
                            ssh \${SSH_OPTS} -p ${params.DEPLOY_PORT} \${REMOTE} "
                                set -e
                                cat > /tmp/${params.DOCKER_IMAGE_NAME}.env
                                chmod 600 /tmp/${params.DOCKER_IMAGE_NAME}.env
                                docker pull ${imageRef}
                                docker stop ${params.DOCKER_IMAGE_NAME} 2>/dev/null || true
                                docker rm ${params.DOCKER_IMAGE_NAME} 2>/dev/null || true
                                docker run -d --restart=always --name ${params.DOCKER_IMAGE_NAME} \\
                                    -p ${params.EXPOSE_APP_PORT}:${params.APP_PORT} \\
                                    --env-file /tmp/${params.DOCKER_IMAGE_NAME}.env \\
                                    ${imageRef}
                                echo '--- 容器状态 ---'
                                docker ps --filter name=${params.DOCKER_IMAGE_NAME}
                            " < .deploy-env
                            rm -f .deploy-env
                            echo "✅ 部署成功: ${params.DOCKER_IMAGE_NAME} (${params.EXPOSE_APP_PORT}:${params.APP_PORT}) on ${params.DEPLOY_HOST}"
                        """
                    }
{{APP_ENV_CRED_CLOSE}}
                }
            }
        }

        stage('Post-Deploy Self-Check (G5 · #398)') {
            when { expression { return params.RUN_DEPLOY } }
            steps {
                script {
                    sh """
                        if [ -f scripts/selfcheck.sh ]; then
                            bash scripts/selfcheck.sh --base http://${params.DEPLOY_HOST}:${params.EXPOSE_APP_PORT} --health-path ${params.HEALTH_PATH}@@G5_EXTRA@@
                        else
                            echo "❌ 缺部署后自证脚本 scripts/selfcheck.sh（#398）"; exit 1
                        fi
                    """
                }
            }
        }
        stage('Merge Back to Master') {
            when {
                // #634: Merge Back = 「改主线」动作，必须与「本次是部署」绑定（RUN_DEPLOY=true）。
                // 只构建取证(RUN_DEPLOY=false) ⇒ 不得合并/推送主线；判据：构建前后 origin/<主line> 不变。
                expression { return params.RUN_DEPLOY == true && (env.BRANCH_NAME =~ /release\/.*/ || env.BRANCH_NAME =~ /hotfix\/.*/) }
            }
            steps {
                script {
                    // 远程合并（GitHub merge API，服务端）——不做本地 checkout/merge/push，避开本地钩子(husky)
                    def url = sh(returnStdout: true, script: 'git remote get-url origin').trim()
                    def slug = url.replaceAll(/^(git@|https?:\/\/)[^\/:]+[:\/]/, '').replaceAll(/\.git$/, '')
                    def parts = slug.split('/')
                    def owner = parts[0]; def repo = parts[1]
                    echo "Remote merge ${env.BRANCH_NAME} -> @@MERGE_BRANCH@@ via GitHub API (${slug})"
                    withCredentials([string(credentialsId: '@@GITHUB_CREDENTIAL_ID@@', variable: 'GH_TOKEN')]) {
                        sh """
                            set -e
                            code=\$(curl -s -o /tmp/mg.json -w '%{http_code}' -X POST \
                              -H "Authorization: Bearer \$GH_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              "https://api.github.com/repos/${owner}/${repo}/merges" \
                              -d '{"base":"@@MERGE_BRANCH@@","head":"${env.BRANCH_NAME}"}')
                            echo "GitHub merge HTTP \$code"; cat /tmp/mg.json 2>/dev/null; echo
                            case "\$code" in 201|204) echo "✅ GitHub 远程合并完成（base=@@MERGE_BRANCH@@ head=${env.BRANCH_NAME}）";; *) echo "❌ GitHub 远程合并失败 HTTP \$code（409=冲突，需人工处理）"; exit 1;; esac
                        """
                        // #576-BACKFILL-BEGIN
                        // #576: Merge Back 后强制回灌 develop（master ⊆ develop），不靠人记得
                        sh """
                            set -e
                            bcode=\$(curl -s -o /dev/null -w '%{http_code}' \
                              -H "Authorization: Bearer \$GH_TOKEN" \
                              -H "Accept: application/vnd.github+json" \
                              "https://api.github.com/repos/${owner}/${repo}/branches/@@BACKFILL_BRANCH@@")
                            if [ "\$bcode" = "404" ]; then
                                echo "⚠️ 远端无 @@BACKFILL_BRANCH@@（本仓未启用 git-flow 双向），跳过回灌（#576）"
                            elif [ "\$bcode" != "200" ]; then
                                echo "❌ 查询 @@BACKFILL_BRANCH@@ 失败 HTTP \$bcode"; exit 1
                            else
                                fcode=\$(curl -s -o /tmp/bf.json -w '%{http_code}' -X POST \
                                  -H "Authorization: Bearer \$GH_TOKEN" \
                                  -H "Accept: application/vnd.github+json" \
                                  "https://api.github.com/repos/${owner}/${repo}/merges" \
                                  -d '{"base":"@@BACKFILL_BRANCH@@","head":"@@MERGE_BRANCH@@"}')
                                echo "GitHub 回灌 merge HTTP \$fcode"; cat /tmp/bf.json 2>/dev/null; echo
                                case "\$fcode" in 201|204) echo "✅ 已回灌：@@MERGE_BRANCH@@ ⊆ @@BACKFILL_BRANCH@@（#576）";; *) echo "❌ 回灌失败 HTTP \$fcode（409=冲突，需人工处理）"; exit 1;; esac
                            fi
                        """
                        // #576-BACKFILL-END
                    }
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline 成功。镜像 ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE_NAME}@${env.IMAGE_DIGEST}（tag ${env.IMAGE_TAG}）；部署：${params.RUN_DEPLOY ? '已部署到 ' + params.DEPLOY_HOST : '已跳过'}"
        }
        failure {
            echo "❌ Pipeline 失败。请查看 Console Output"
        }
        cleanup {
            echo "--- 清理工作区 ---"
            // 用 shell 快删替代 cleanWs()（避免 ws-cleanup 异步残留堆积，见 docs/ops/Jenkins-workspace-膨胀治理-操作手册.md）
            sh 'rm -rf -- * .[^.]* || true'
        }
    }
}
